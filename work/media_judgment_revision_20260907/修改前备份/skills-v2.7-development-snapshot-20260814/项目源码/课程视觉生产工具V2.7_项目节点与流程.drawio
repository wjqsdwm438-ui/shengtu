        <mxCell id="fl-todo" value="硬性禁止&#10;不使用哈希方案｜不自动追加上游文件&#10;不把建议当确认｜不代替用户冻结设计方向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
