          <mxGeometry x="315" y="65" width="235" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fl-atype" value="A：明确分页方案&#10;统一页界、正文归属与教学关系&#10;给出页数、各页任务及拆合依据&#10;页面身份随后生成；不从字幕预建" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="fl-a-stage">
          <mxGeometry x="1215" y="65" width="315" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fl-agate" value="A：实际承载核验&#10;把必要正文、关系和视觉载体&#10;放入真实限制内检验可承载性&#10;字数等单项检查不能代替核验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="fl-a-stage">
          <mxGeometry x="900" y="65" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fl-userclarify" value="必要追问 Gate（仅真实未决事项）&#10;先读本地并复用有效批准&#10;提交具体方案与未决差异&#10;说明回答会改变哪个动作&#10;不让用户代做分页或视觉设计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1640" y="695" width="285" height="165" as="geometry" />
        </mxCell>
        <mxCell id="fl-aoutput" value="共享页面简报 A 区&#10;明确分页方案、教学关系与约束&#10;记录实际承载核验依据&#10;批准状态与内部核验分开记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="fl-a-stage">
          <mxGeometry x="890" y="260" width="280" height="135" as="geometry" />
        </mxCell>
        <mxCell id="fl-areview" value="A 内部复核（不是独立 Gate）&#10;核对全文覆盖、页界、教学关系&#10;以及真实限制下的承载证据&#10;不通过仅在 A 内修正后继续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="fl-a-stage">
          <mxGeometry x="1220" y="260" width="310" height="135" as="geometry" />
        </mxCell>
        <mxCell id="fl-localcard" value="独立审者不是默认回路&#10;仅用户明确要求时执行&#10;本轮不定义自动触发条件&#10;不能因设计推断不足让用户补做设计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="fl-a-stage">
          <mxGeometry x="455" y="260" width="375" height="135" as="geometry" />
        </mxCell>
        <mxCell id="fl-bline" value="B｜具体视觉设计与生产组织&#10;构图、层级、素材与执行参数&#10;基于 A 方案提出唯一可执行设计&#10;用实际实现结果反馈，不转嫁给用户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="700" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="fl-bgate" value="B 实现核验&#10;纯实现问题由 B 解决&#10;影响分页时附证据局部回 A&#10;A 统一改页界 / 正文归属 / 教学关系&#10;不重跑 S → A → B" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1155" y="910" width="295" height="175" as="geometry" />
        </mxCell>
        <mxCell id="fl-select" value="B线批次合同&#10;保留原课程序号但按机制分批&#10;代表页通过前方案可校准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1510" y="930" width="280" height="135" as="geometry" />
        </mxCell>
        <mxCell id="fl-tline" value="C线执行适配器&#10;校验简报、素材与参数&#10;编译结构化执行提示&#10;不得新增设计判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1510" y="1190" width="280" height="145" as="geometry" />
        </mxCell>
        <mxCell id="fl-tgate" value="C适配完整性 Gate&#10;尺寸、模板、主视觉、素材完整？&#10;空值、矛盾或缺文件立即停止" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1155" y="1180" width="295" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fl-predict" value="批次代表页校准&#10;每批独立上下文&#10;说明风险、固定项与可变项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#E11D48;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="815" y="1200" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fl-gpt-image" value="生图执行&#10;先生成代表页；确认后扩展本批&#10;批内只携带必要上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#E11D48;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="475" y="1440" width="290" height="125" as="geometry" />
        </mxCell>
        <mxCell id="fl-confirm" value="用户确认本批代表页？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="1420" width="275" height="175" as="geometry" />
        </mxCell>
        <mxCell id="fl-delivery" value="是&#10;冻结本批执行合同&#10;扩展其余页面&#10;最后按课程序号组装" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="1430" width="290" height="160" as="geometry" />
        </mxCell>
        <mxCell id="fl-diagnose" value="否 / 需要修改&#10;失败分类：内容、结构、审美、文字&#10;素材、继承、范围、模型边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="815" y="1650" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fl-revision" value="局部修改合同&#10;keep_items / change_only_items&#10;forbidden_changes / minimal prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1180" y="1650" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="fl-return" value="缺陷属于哪一层？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1550" y="1640" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fl-manifest" value="产物与交接方案用户 Gate（无 Manifest）&#10;写入前先说明：产物、路径、是否修改旧文件、下游所需、非交付记录&#10;用户确认后才写；不自动追加上游文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;dashed=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="340" height="145" as="geometry" />
        </mxCell>
        <mxCell id="fl-alg" value="Algorithm Lite｜按需调用，只提供证据&#10;SRT 索引不定义页面身份&#10;文字预算 / 骨架 / 复杂度：辅助 A、B&#10;不能仅凭字数跳过实际承载核验&#10;ALG-B01 / C01 当前为人工规则清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;dashed=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
