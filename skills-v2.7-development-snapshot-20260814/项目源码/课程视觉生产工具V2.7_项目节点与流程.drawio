        <mxCell id="ov-input" value="输入材料（版式优先）&#10;先看版式 / 母版 / 预览 / 参考图&#10;再读 SRT / 脚本 / 单页内容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
