        </mxCell>
        <mxCell id="fl-agate" value="A线关键条件明确？&#10;设计方向 / 母版角色 / 参考继承&#10;文字策略 / 最终方案&#10;每项都须用户确认" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
