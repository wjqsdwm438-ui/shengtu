        <mxCell id="fl-atype" value="A01–A21&#10;页面类型判断&#10;Top1 / Top2 / 风险 / Gate" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
