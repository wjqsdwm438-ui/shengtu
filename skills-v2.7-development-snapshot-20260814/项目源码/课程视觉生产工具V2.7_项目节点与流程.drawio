        </mxCell>
        <mxCell id="ov-ar" value="A审｜质量 Gate&#10;通过｜局部补卡&#10;退回 A线" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1020" y="145" width="150" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ov-b" value="B线｜生产交接&#10;方案A 稳妥版 / 方案B 探索版&#10;只比较与建议，由用户确认首选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1210" y="150" width="160" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ov-t" value="T线｜中文生图执行提示词&#10;只转译用户已确认的方案&#10;新增视觉判断先提议、后确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1410" y="150" width="160" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ov-c" value="C线｜生图执行反馈&#10;抽样页、提示词版本、每次生图分别确认&#10;生图后再确认视觉样张" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#E11D48;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1410" y="320" width="160" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ov-user-gate" value="用户确认 Gate&#10;每次只问一个问题&#10;当前回答前不询问下一项&#10;当前授权不自动延伸到下一步" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1210" y="320" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ov-state" value="最小执行边界（纯文字规则）&#10;默认只读分析与提议&#10;一次明确授权只覆盖一个产物&#10;完成后立即停止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="330" width="180" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ov-alg" value="Algorithm Lite｜伴随证据链（不替代阶段决策）&#10;ALG-S01 字幕索引｜ALG-A02 文字预算/骨架｜ALG-A03 复杂度评分&#10;ALG-B01、ALG-C01 当前为规则清单，尚未脚本化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;dashed=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
