        <mxCell id="ov-s" value="S线｜媒介分流&#10;缺音频 / 时长 / 时间码时分别追问&#10;确认处理范围、Non-A、A线清单与分页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="150" width="170" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ov-a" value="A线｜课程视觉路由&#10;三版只提议、不自动冻结&#10;用户逐项确认后才形成交接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
