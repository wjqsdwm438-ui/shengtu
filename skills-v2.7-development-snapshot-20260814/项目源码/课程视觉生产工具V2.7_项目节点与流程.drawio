        <mxCell id="fl-start" value="开始&#10;默认只读分析与计划" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fl-recognize" value="版式优先读取与分类&#10;先看版式 / 母版 / 预览 / 参考图&#10;按六类输出分类依据与结果&#10;再读取课程内容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="210" y="140" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fl-smerge" value="S线：读取内容与语义合并&#10;保留时间范围与来源行&#10;不按字幕句逐页切分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="450" y="140" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fl-sroute" value="S01–S08&#10;媒介路由判断" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="130" width="160" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fl-nona" value="S01–S06&#10;有效的非 A线生产路线&#10;教师出镜 / 现成素材 / 录屏&#10;字幕标注与后期包装" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="660" y="300" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="fl-s08" value="S线用户 Gate&#10;依次检查：音频→时长→时间码→处理片段&#10;→Non-A→进入A线清单→分页&#10;缺一项只问一个问题，确认前停止" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="305" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fl-s07" value="S07&#10;AI 课程视觉页型&#10;仅在用户确认进入A线后继续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="140" width="175" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fl-abound" value="A线：材料边界与教学动作&#10;页面密度、内容关系、文字策略&#10;视觉载体、前后景与风险阻断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
