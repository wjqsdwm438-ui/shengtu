        <mxCell id="fl-start" value="开始&#xa;接收任务输入" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="130" height="70" as="geometry"/></mxCell>
        <mxCell id="fl-recognize" value="输入类型识别&#xa;SRT / 脚本 / 单页内容&#xa;参考图 / 失败样张 / 局部修改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210" y="140" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="fl-smerge" value="S线：语义合并&#xa;保留时间范围与来源行&#xa;不按字幕句逐页切分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="450" y="140" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="fl-sroute" value="S01–S08&#xa;媒介路由判断" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="130" width="160" height="110" as="geometry"/></mxCell>
        <mxCell id="fl-nona" value="S01–S06&#xa;有效的非 A线生产路线&#xa;教师出镜 / 现成素材 / 录屏&#xa;字幕标注与后期包装" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="300" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="fl-s08" value="S08&#xa;媒介证据不足或高歧义&#xa;询问缺失决定" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="305" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="fl-s07" value="S07&#xa;AI 课程视觉页型&#xa;默认进入 A线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="140" width="175" height="90" as="geometry"/></mxCell>

        <mxCell id="fl-abound" value="A线：材料边界与教学动作&#xa;页面密度、内容关系、文字策略&#xa;视觉载体、前后景与风险阻断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1140" y="135" width="225" height="100" as="geometry"/></mxCell>
        <mxCell id="fl-atype" value="A01–A21&#xa;页面类型判断&#xa;Top1 / Top2 / 风险 / Gate" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1415" y="125" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="fl-agate" value="关键条件明确？&#xa;页面含义 / 必须上屏文字&#xa;参考图角色 / 素材授权&#xa;超过 180 字处理方式" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="300" width="180" height="135" as="geometry"/></mxCell>
        <mxCell id="fl-userclarify" value="用户 Gate&#xa;只询问缺失或冲突的决定&#xa;确认后返回当前阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1160" y="320" width="200" height="95" as="geometry"/></mxCell>
        <mxCell id="fl-aoutput" value="A线输出&#xa;当前判断＋主要问题＋三版方案&#xa;冻结交接卡＋light_region_summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1640" y="310" width="130" height="120" as="geometry"/></mxCell>

        <mxCell id="fl-areview" value="A审质量 Gate" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1435" y="500" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="fl-localcard" value="局部补卡&#xa;补齐缺失字段后复审" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1190" y="505" width="175" height="90" as="geometry"/></mxCell>
        <mxCell id="fl-bline" value="B线：四 Gate＋六项检查&#xa;生成方案A 稳妥版&#xa;与方案B 探索版" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1620" y="505" width="155" height="100" as="geometry"/></mxCell>
