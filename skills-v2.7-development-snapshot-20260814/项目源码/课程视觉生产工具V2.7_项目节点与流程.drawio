        <mxCell id="ov-shared" value="共享最小规则&#10;course-visual-production-v2.7.md&#10;&#10;版式优先｜一次一个问题｜用户确认后产出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=2;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
