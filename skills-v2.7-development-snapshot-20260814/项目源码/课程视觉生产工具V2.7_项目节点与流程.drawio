        </mxCell>
        <mxCell id="ov-manifest" value="产物与交接提议（不设统一 Manifest）&#10;写入前说明产物、路径、是否改旧文件与下游所需&#10;用户确认后才写；不自动追加上游文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;dashed=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
